# === AMÉLIORATION AJOUTÉE : protection des données (revue 2026-09-05, section 3.3) ===
# GEMINI_API_KEY a été retirée : le SDK @google/genai (vestige du template Google AI Studio
# dont ce projet est issu) n'était appelé nulle part dans le code — dépendance et surface
# d'attaque inutiles. Aucune donnée de santé ne doit transiter vers un service d'IA tiers sans
# accord de sous-traitance (DPA) formalisé au préalable ; si une fonctionnalité d'IA est
# ajoutée un jour, ce garde-fou doit être matérialisé dans le code (validation/anonymisation
# avant tout appel), pas seulement documenté ici.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# === AMÉLIORATION AJOUTÉE : sécurité (Revue complète 2026-09-06, finding #6 — CRITIQUE) ===
# VITE_ALLOW_DEMO_FALLBACK : n'a d'effet QUE si la valeur est exactement "true". Autorise
# src/services/firestore.ts à retomber sur des données de démonstration (getFullDemoData())
# quand une collection Firestore est vide ou en erreur — voir src/config/demoFallback.ts.
# NE JAMAIS définir cette variable dans un build de production : sans elle (comportement par
# défaut), un incident Firestore réel affiche un écran vide + une bannière d'avertissement
# visible (voir src/components/SyncIssueBanner.tsx) au lieu de données fictives qui pourraient
# être prises pour de vraies données par un utilisateur. À définir uniquement dans un
# environnement de démonstration/développement local qui a besoin de données d'exemple.
# VITE_ALLOW_DEMO_FALLBACK="true"
