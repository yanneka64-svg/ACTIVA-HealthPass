# === AMÉLIORATION AJOUTÉE : protection des données (revue 2026-09-05, section 3.3) ===
# GEMINI_API_KEY a été retirée : le SDK @google/genai (vestige du template Google AI Studio
# dont ce projet est issu) n'était appelé nulle part dans le code — dépendance et surface
# d'attaque inutiles. Aucune donnée de santé ne doit transiter vers un service d'IA tiers sans
# accord de sous-traitance (DPA) formalisé au préalable ; si une fonctionnalité d'IA est
# ajoutée un jour, ce garde-fou doit être matérialisé dans le code (validation/anonymisation
# avant tout appel), pas seulement documenté ici.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Administrative & Migration Service Authentication (optional, kept strictly server-side)
SERVER_AUTH_EMAIL=
SERVER_AUTH_PASSWORD=
MIGRATION_ADMIN_EMAIL=
MIGRATION_ADMIN_PASSWORD=
