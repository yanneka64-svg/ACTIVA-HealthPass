<?xml version="1.0" encoding="utf-8"?>
<!--
    === AMÉLIORATION AJOUTÉE : ébauche non testée (2026-09-22) — voir README.md à la racine de
    android-bridge/ pour le statut complet et les sources de chaque valeur ci-dessous.

    android.hardware.usb.host : présent dans le manifest du projet source MidX fourni par
    l'utilisateur, et cohérent avec les méthodes privées observées par décompilation du .aar
    (checkUsbDevices(), setupFingerDevice(), fingerprintPower(boolean)) — le SDK FingerSDK gère
    lui-même la communication USB avec le capteur, cette coquille n'a rien à faire elle-même
    côté USB au-delà de déclarer la feature/permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- === AMÉLIORATION AJOUTÉE : revue automatisée (2026-09-22) — @mipmap/ic_launcher est
         fourni à la fois en icône adaptative (res/mipmap-anydpi-v26/, API 26+) ET en repli
         raster par densité (res/mipmap-{m,h,xh,xxh,xxxh}dpi/ic_launcher*.png, API 24-25 — minSdk
         est 24 dans app/build.gradle ; sans ce repli, ces appareils affichaient une icône
         générique au lieu du placeholder ACTIVA, signalé par la revue automatisée). Même design
         simple (placeholder, pas une charte graphique définitive) que les fichiers .xml sous
         res/drawable/ — voir le détail et l'avertissement là-bas. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ACTIVA HealthPass Bridge"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name="com.activa.healthpass.bridge.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
