rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // === ADDED IMPROVEMENT ===
    // This Firebase project had no explicit Storage rules in the repository: Firebase
    // Storage was in fact never used by the code (see src/utils/storageUtils.ts). This
    // file restricts access to member/enrollment photos to authenticated users only,
    // mirroring firestore.rules — consistent with the rest of the security audit (no
    // anonymous access to members' personal data).
    //
    // IMPORTANT (deployment): this file must be deployed to the Firebase project via
    // `firebase deploy --only storage` to take effect. This session has no deployment
    // access to the real project. Until it's deployed, uploads use the automatic fallback
    // to the existing base64 storage (see storageUtils.ts) — no regression in the meantime.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
