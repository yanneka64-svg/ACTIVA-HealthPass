// === AMÉLIORATION AJOUTÉE : sécurité (audit) ===
// Firebase Storage est utilisé sur cette branche par src/utils/storageUtils.ts
// (uploadString/getDownloadURL — photos des assurés). Sans ce fichier, un bucket Firebase
// Storage nouvellement activé pour ce projet retomberait sur les règles par défaut de
// Firebase (souvent permissives en mode test), exposant les photos déposées à un accès
// public non désiré. Ce fichier applique le même principe que firestore.rules : accès
// réservé aux utilisateurs connectés via Firebase Auth — aligné sur le fichier équivalent
// harmonisé avec la branche main (voir firestore.rules), sans changer le comportement
// observé de l'upload/affichage des photos.
// IMPORTANT (déploiement) : ce fichier doit être déployé sur le projet Firebase via
// `firebase deploy --only storage` pour prendre effet ; cette session n'a pas d'accès de
// déploiement au projet réel.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
