rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // === CORRECTIF DE SÉCURITÉ CRITIQUE ===
    // Avant ce correctif, TOUTES les collections avaient `allow read, write: if true;` —
    // c'est-à-dire que N'IMPORTE QUI sur Internet, sans être connecté, pouvait lire et
    // modifier/supprimer l'intégralité de la base : dossiers médicaux et données
    // personnelles des assurés (members, claims, medicalForms, enrollments), données
    // financières (invoices, ceilings), et surtout les comptes utilisateurs (accounts),
    // qui stockent un mot de passe temporaire en clair (champs `password`/`tempPassword`).
    // Ce fichier, une fois DÉPLOYÉ sur le projet Firebase (voir note en bas), restreint
    // l'accès aux seuls utilisateurs authentifiés pour toutes les collections métier.
    //
    // Exception documentée : la collection `accounts` doit rester lisible sans
    // authentification en LECTURE SEULE, car l'écran de connexion (LoginView.tsx) a
    // besoin de retrouver le compte correspondant au nom d'utilisateur saisi AVANT que
    // la connexion Firebase Auth n'existe (et la fonctionnalité "Réinitialiser le mot de
    // passe" en dépend également). Interdire cette lecture casserait la connexion par nom
    // d'utilisateur et la réinitialisation de mot de passe pour de vrais utilisateurs.
    // C'est un risque résiduel connu, documenté dans le rapport d'audit fourni à
    // l'utilisateur : la correction complète nécessite de déplacer cette recherche vers
    // une Cloud Function (Admin SDK), hors de portée de ce correctif (aucun accès de
    // déploiement/test sur le projet Firebase réel depuis cet environnement). En
    // attendant, l'ÉCRITURE sur `accounts` est déjà restreinte aux utilisateurs
    // authentifiés ci-dessous, ce qui empêche déjà la création/modification/suppression
    // de comptes par un attaquant non authentifié (le pire des deux risques).
    match /accounts/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /members/{memberId} {
      allow read, write: if isSignedIn();
    }

    match /claims/{claimId} {
      allow read, write: if isSignedIn();
    }

    match /medicalForms/{formId} {
      allow read, write: if isSignedIn();
    }

    match /enrollments/{enrollmentId} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    match /organizations/{orgId} {
      allow read, write: if isSignedIn();
    }

    match /providers/{providerId} {
      allow read, write: if isSignedIn();
    }

    match /ceilings/{ceilingId} {
      allow read, write: if isSignedIn();
    }

    match /loginLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // Retiré : le catch-all `match /{document=**} { allow read, write: if true; }` qui
    // ouvrait aussi TOUTE future collection non listée ci-dessus à tout le monde. Sans
    // règle explicite, Firestore refuse l'accès par défaut — c'est le comportement voulu.
  }
}
