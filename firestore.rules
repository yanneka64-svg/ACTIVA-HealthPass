rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAccount() {
      return isSignedIn() && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSignedIn() && (
        ('isActive' in request.auth.token && request.auth.token.isActive != false) ||
        (!('isActive' in request.auth.token) && hasAccount() && getUserData().isActive != false)
      );
    }

    function userProfile() {
      return 'role' in request.auth.token ? request.auth.token.role : (hasAccount() ? getUserData().profile : '');
    }

    function isAdmin() {
      return isActiveUser() && userProfile() == 'Admin';
    }

    function isSupervisor() {
      return isActiveUser() && (userProfile() == 'Supervisor' || userProfile() == 'Superviseur');
    }

    function isAgent() {
      return isActiveUser() && userProfile() == 'Agent';
    }

    function canValidate() {
      return isAdmin() || isSupervisor();
    }

    // accounts collection
    match /accounts/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.profile != 'Admin')
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.profile == resource.data.profile &&
         request.resource.data.isActive == resource.data.isActive &&
         request.resource.data.permissions == resource.data.permissions)
      );
      allow delete: if isAdmin();
    }

    // members collection
    match /members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser();
      allow update: if isSignedIn() && isActiveUser();
      allow delete: if isAdmin();
    }

    // counters collection (card number sequence preservation)
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif HIGH) — la garde anti-régression
    // vérifiait un champ nommé "lastInsuredNumber", qui n'existe nulle part dans le code réel
    // (client cardNumberService.ts, Cloud Functions cardService.ts/importService.ts, type
    // CardNumberCounters) : le champ s'appelle partout "lastAssuredNumber". Comme ce champ
    // n'existait donc jamais sous l'ancien nom, la condition `!('lastInsuredNumber' in
    // resource.data)` était toujours vraie et la garde ne protégeait rien — n'importe quel
    // utilisateur actif pouvait faire reculer le compteur, ouvrant la voie à une
    // réattribution de numéro déjà consommé. Corrigé en utilisant le vrai nom de champ.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser();
      allow update: if isSignedIn() && isActiveUser() && (
        !('lastAssuredNumber' in resource.data) ||
        !('lastAssuredNumber' in request.resource.data) ||
        request.resource.data.lastAssuredNumber >= resource.data.lastAssuredNumber
      );
      allow delete: if false;
    }

    // cardNumberRegistry collection (strictly immutable)
    match /cardNumberRegistry/{cardNumber} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser();
      allow update, delete: if false;
    }

    function policyBlocksCoverage(orgName) {
      return orgName is string && orgName.size() > 0 &&
        exists(/databases/$(database)/documents/healthPolicies/$(orgName)) &&
        get(/databases/$(database)/documents/healthPolicies/$(orgName)).data.coverageBlocked == true;
    }

    // healthPolicies collection
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif HIGH) — la règle précédente autorisait
    // n'importe quel utilisateur actif (y compris Agent) à écrire n'importe quelle valeur
    // dans `coverageBlocked`/`status`, du moment qu'il ne touchait à aucun autre champ. Elle
    // ne vérifiait QUELS champs changent, jamais QUELLE VALEUR est écrite : un Agent pouvait
    // donc lever lui-même un blocage de couverture (coverageBlocked: false) sur une police
    // Suspendue/Expirée en appelant directement le SDK Firestore, contournant entièrement
    // policyBlocksCoverage() (qui bloque claims/medicalForms sur ce même champ). Corrigé en
    // n'autorisant le passage true -> false ("déblocage") qu'à Admin/Supervisor ; le sens
    // inverse (marquer une police bloquée) reste ouvert à tout utilisateur actif, car c'est
    // le sens utilisé par la synchronisation automatique cliente
    // (WorkflowService.syncPolicyStatuses, exécutée pour CHAQUE session authentifiée, faute
    // de Cloud Function planifiée pour détecter les transitions basées sur la date) et il
    // n'introduit aucun risque : rendre une police PLUS restrictive n'est jamais une
    // élévation de privilège.
    match /healthPolicies/{organizationName} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() && isActiveUser() && (
        isAdmin() || isSupervisor() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'coverageBlocked', 'updatedAt', 'lastEvaluatedAt']) &&
          !(resource.data.coverageBlocked == true && request.resource.data.coverageBlocked != true)
        )
      );
    }

    // policyPayments collection (financial transactions restricted to Admin)
    match /policyPayments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // claims collection (with SoD validation enforcement)
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif LOW) — `isAdmin() ||` en tête de la
    // condition court-circuitait le test d'auto-approbation pour un Admin : un Admin qui aurait
    // créé sa propre réclamation (autorisé par la matrice de permissions) pouvait se
    // l'approuver lui-même, contrairement à ce que documente AUDIT_AND_HARDENING_REPORT.md
    // ("Admin... sauf s'il en est lui-même l'auteur direct") et à ce qu'applique la Cloud
    // Function processClaimDecisionServer (qui bloque l'auto-approbation pour TOUT rôle).
    // Corrigé pour que Admin soit soumis au même test d'auto-approbation que Supervisor.
    match /claims/{claimId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser() && !policyBlocksCoverage(request.resource.data.organization);
      allow update: if isSignedIn() && isActiveUser() && (
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) ||
        ((isAdmin() || isSupervisor()) && (!('createdBy' in resource.data) || resource.data.createdBy != request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    // medicalForms collection
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif MEDIUM) — la suppression était ouverte à
    // tout utilisateur actif, sans notion de propriétaire (le type MedicalForm ne porte aucun
    // champ createdBy) : n'importe quel Agent pouvait donc supprimer la fiche médicale de
    // n'importe quel autre Agent, y compris via le nouveau bouton "Clear All History" qui
    // supprime TOUTE la collection en un seul lot, quel que soit l'auteur ou l'organisation.
    // Restreint à isAdmin(), cohérent avec claims/enrollments ci-dessus et avec la matrice de
    // permissions (permissions.ts : suppression réservée à Admin, jamais Agent/Supervisor).
    match /medicalForms/{formId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser() && !policyBlocksCoverage(request.resource.data.organization);
      allow update: if isSignedIn() && isActiveUser();
      allow delete: if isAdmin();
    }

    // enrollments collection (with SoD validation enforcement)
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif LOW) — même correctif que /claims
    // ci-dessus : Admin soumis au même test d'auto-approbation que Supervisor.
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser();
      allow update: if isSignedIn() && isActiveUser() && (
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) ||
        ((isAdmin() || isSupervisor()) && (!('createdBy' in resource.data) || resource.data.createdBy != request.auth.uid))
      );
      allow delete: if isAdmin();
    }

    // invoices collection (issued receipts upon claim approval)
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isActiveUser() && canValidate();
      allow delete: if isAdmin();
    }

    // organizations, providers, ceilings (administrative masters)
    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /providers/{providerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /ceilings/{ceilingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // loginLogs & auditLogs (append-only, immutable)
    match /loginLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || isSupervisor());
      allow create: if true;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
