rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // === CRITICAL SECURITY FIX ===
    // Before this fix, EVERY collection had `allow read, write: if true;` — meaning
    // ANYONE on the Internet, without being signed in, could read and modify/delete the
    // entire database: medical records and personal data of insured members (members,
    // claims, medicalForms, enrollments), financial data (invoices, ceilings), and above
    // all user accounts (accounts), which store a temporary password in plaintext
    // (`password`/`tempPassword` fields).
    // This file, once DEPLOYED to the Firebase project (see note at the bottom), restricts
    // access to authenticated users only for every business collection.
    //
    // Documented exception: the `accounts` collection must remain readable without
    // authentication in READ-ONLY mode, because the login screen (LoginView.tsx) needs to
    // look up the account matching the entered username BEFORE the Firebase Auth session
    // exists (and the "Reset Password" feature depends on it too). Blocking this read
    // would break username-based login and password resets for real users. This is a
    // known residual risk, documented in the audit report delivered to the user: the full
    // fix requires moving this lookup to a Cloud Function (Admin SDK), which is out of
    // scope for this fix (no deployment/testing access to the real Firebase project from
    // this environment). In the meantime, WRITE access to `accounts` is already restricted
    // to authenticated users below, which already prevents an unauthenticated attacker
    // from creating/modifying/deleting accounts (the more severe of the two risks).
    match /accounts/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /members/{memberId} {
      allow read, write: if isSignedIn();
    }

    match /claims/{claimId} {
      allow read, write: if isSignedIn();
    }

    match /medicalForms/{formId} {
      allow read, write: if isSignedIn();
    }

    match /enrollments/{enrollmentId} {
      allow read, write: if isSignedIn();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
    }

    match /organizations/{orgId} {
      allow read, write: if isSignedIn();
    }

    match /providers/{providerId} {
      allow read, write: if isSignedIn();
    }

    match /ceilings/{ceilingId} {
      allow read, write: if isSignedIn();
    }

    match /loginLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    // Removed: the open catch-all `match /{document=**} { allow read, write: if true; }`
    // which also opened up ANY future collection not listed above to everyone. Without an
    // explicit rule, Firestore denies access by default — that is the intended behavior.
  }
}
