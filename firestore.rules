rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAccount() {
      return isSignedIn() && exists(/databases/$(database)/documents/accounts/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSignedIn() && (
        ('isActive' in request.auth.token && request.auth.token.isActive != false) ||
        (!('isActive' in request.auth.token) && hasAccount() && getUserData().isActive != false)
      );
    }

    function userProfile() {
      return 'role' in request.auth.token ? request.auth.token.role : (hasAccount() ? getUserData().profile : '');
    }

    function isAdmin() {
      return isActiveUser() && userProfile() == 'Admin';
    }

    function isSupervisor() {
      return isActiveUser() && (userProfile() == 'Supervisor' || userProfile() == 'Superviseur');
    }

    function isAgent() {
      return isActiveUser() && userProfile() == 'Agent';
    }

    function canValidate() {
      return isAdmin() || isSupervisor();
    }

    // === AMÉLIORATION AJOUTÉE : sécurité (Phase 1.3 — isolation par organisation) ===
    // Problème : jusqu'ici, `members`/`claims`/`medicalForms`/`enrollments`/`invoices`/
    // `policyPayments` n'imposaient aucune restriction liée à l'organisation cliente — un
    // Agent authentifié pouvait lire/écrire les dossiers de N'IMPORTE QUELLE organisation via
    // le SDK Firestore, indépendamment de ce que l'interface lui affiche (voir
    // docs/security/CODE_AUDIT_MAP.md, section 1 et 11).
    // Preuve dans le code existant : `accounts` ne portait aucun champ de rattachement à une
    // organisation cliente (vérifié sur UserAccount, src/types/index.ts) — la Phase 0 s'est
    // arrêtée sur ce point précis avant toute modification, conformément à la règle absolue
    // du brief ; l'utilisateur a tranché pour l'option "champ additif rétrocompatible".
    // Pourquoi aucun usage légitime n'est cassé : `assignedOrganizations` est un nouveau champ
    // OPTIONNEL sur `accounts`, absent par défaut sur tous les comptes existants. Tant qu'il
    // n'est pas explicitement renseigné par un Admin pour un compte donné, `hasOrgAccess()`
    // retourne systématiquement `true` (accès inchangé, identique à avant ce correctif). La
    // restriction ne prend effet que pour un compte auquel un Admin a explicitement assigné une
    // liste d'organisations. Un Admin garde toujours un accès total (isAdmin() prioritaire),
    // et un Custom Claim `orgs` (Phase 1.2, pas encore posé par le code à ce jour) est lu en
    // priorité s'il existe un jour, pour rester cohérent avec isActiveUser()/userProfile().
    // Ce qui est désormais empêché : un compte Agent/Supervisor auquel un Admin a assigné un
    // périmètre d'organisations ne peut plus lire ni écrire de document appartenant à une
    // organisation hors de ce périmètre, y compris via un appel direct au SDK Firestore
    // contournant l'interface.
    function assignedOrganizations() {
      return ('orgs' in request.auth.token)
        ? request.auth.token.orgs
        : (hasAccount() && ('assignedOrganizations' in getUserData()) ? getUserData().assignedOrganizations : null);
    }

    function hasOrgAccess(orgName) {
      return isAdmin() || assignedOrganizations() == null || (orgName in assignedOrganizations());
    }

    // === AMÉLIORATION AJOUTÉE : sécurité (Phase 1.4 — SoD, createdByUid déterminé serveur) ===
    // Problème : le test de non-auto-approbation existant se basait uniquement sur `createdBy`,
    // un champ ENTIÈREMENT fourni par le client (voir src/services/workflowService.ts avant ce
    // correctif : `createdBy: claimData.createdBy || currentUser?.uid || 'user_id'` — la valeur
    // du client, si fournie, prenait le pas). Un appel direct au SDK Firestore (hors de
    // l'application) pouvait donc créer un claim/enrollment SANS `createdBy`, ou avec une
    // valeur arbitraire, pour ensuite se l'auto-approuver en contournant la séparation des
    // tâches — la garde `!('createdBy' in resource.data)` ci-dessous existait justement pour
    // ne jamais bloquer un document légitimement dépourvu de créateur (ex. données de
    // démonstration), mais elle profitait alors aussi à un contournement délibéré.
    // Correctif : `createdByUid`, quand il est fourni à la création, DOIT être exactement
    // request.auth.uid (vérifié ci-dessous dans chaque `allow create`) — un client ne peut
    // donc plus usurper l'identité d'un tiers dans ce champ. `isSelfCreated()` privilégie ce
    // champ vérifié quand il existe ; à défaut (documents créés avant ce correctif, ou
    // données de démonstration sans notion de créateur), le comportement retombe EXACTEMENT
    // sur l'ancien test par `createdBy`, sans aucune régression.
    // Ce que ce correctif empêche désormais : un utilisateur ne peut plus se faire passer pour
    // quelqu'un d'autre dans `createdByUid` pour later revendiquer ne pas être l'auteur réel
    // d'un dossier qu'il a lui-même soumis.
    function isSelfCreated(data) {
      return ('createdByUid' in data)
        ? data.createdByUid == request.auth.uid
        : (('createdBy' in data) && data.createdBy == request.auth.uid);
    }

    function createdByUidValid() {
      return !('createdByUid' in request.resource.data) || request.resource.data.createdByUid == request.auth.uid;
    }

    // accounts collection
    match /accounts/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && request.resource.data.profile != 'Admin')
      );
      // === AMÉLIORATION AJOUTÉE : sécurité (Phase 1.3) — un utilisateur ne doit jamais
      // pouvoir s'auto-assigner ou s'auto-élargir un périmètre d'organisations via une
      // écriture directe sur son propre compte (élévation de privilège). Ajouté à la liste
      // des champs figés par le self-update, au même titre que profile/isActive/permissions
      // déjà protégés ci-dessous. Comparaison tolérante à l'absence du champ des deux côtés
      // (cas normal : la plupart des comptes n'ont pas encore ce champ).
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.profile == resource.data.profile &&
         request.resource.data.isActive == resource.data.isActive &&
         request.resource.data.permissions == resource.data.permissions &&
         (
           (!('assignedOrganizations' in resource.data) && !('assignedOrganizations' in request.resource.data)) ||
           request.resource.data.assignedOrganizations == resource.data.assignedOrganizations
         ))
      );
      allow delete: if isAdmin();
    }

    // members collection
    match /members/{memberId} {
      allow read: if isSignedIn() && hasOrgAccess(resource.data.organization);
      allow create: if isSignedIn() && isActiveUser() && hasOrgAccess(request.resource.data.organization);
      allow update: if isSignedIn() && isActiveUser() &&
        hasOrgAccess(resource.data.organization) &&
        (!('organization' in request.resource.data) || hasOrgAccess(request.resource.data.organization));
      allow delete: if isAdmin();
    }

    // counters collection (card number sequence preservation)
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif HIGH) — la garde anti-régression
    // vérifiait un champ nommé "lastInsuredNumber", qui n'existe nulle part dans le code réel
    // (client cardNumberService.ts, Cloud Functions cardService.ts/importService.ts, type
    // CardNumberCounters) : le champ s'appelle partout "lastAssuredNumber". Comme ce champ
    // n'existait donc jamais sous l'ancien nom, la condition `!('lastInsuredNumber' in
    // resource.data)` était toujours vraie et la garde ne protégeait rien — n'importe quel
    // utilisateur actif pouvait faire reculer le compteur, ouvrant la voie à une
    // réattribution de numéro déjà consommé. Corrigé en utilisant le vrai nom de champ.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser();
      allow update: if isSignedIn() && isActiveUser() && (
        !('lastAssuredNumber' in resource.data) ||
        !('lastAssuredNumber' in request.resource.data) ||
        request.resource.data.lastAssuredNumber >= resource.data.lastAssuredNumber
      );
      allow delete: if false;
    }

    // cardNumberRegistry collection (strictly immutable)
    match /cardNumberRegistry/{cardNumber} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActiveUser();
      allow update, delete: if false;
    }

    function policyBlocksCoverage(orgName) {
      return orgName is string && orgName.size() > 0 &&
        exists(/databases/$(database)/documents/healthPolicies/$(orgName)) &&
        get(/databases/$(database)/documents/healthPolicies/$(orgName)).data.coverageBlocked == true;
    }

    // healthPolicies collection
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif HIGH) — la règle précédente autorisait
    // n'importe quel utilisateur actif (y compris Agent) à écrire n'importe quelle valeur
    // dans `coverageBlocked`/`status`, du moment qu'il ne touchait à aucun autre champ. Elle
    // ne vérifiait QUELS champs changent, jamais QUELLE VALEUR est écrite : un Agent pouvait
    // donc lever lui-même un blocage de couverture (coverageBlocked: false) sur une police
    // Suspendue/Expirée en appelant directement le SDK Firestore, contournant entièrement
    // policyBlocksCoverage() (qui bloque claims/medicalForms sur ce même champ). Corrigé en
    // n'autorisant le passage true -> false ("déblocage") qu'à Admin/Supervisor ; le sens
    // inverse (marquer une police bloquée) reste ouvert à tout utilisateur actif, car c'est
    // le sens utilisé par la synchronisation automatique cliente
    // (WorkflowService.syncPolicyStatuses, exécutée pour CHAQUE session authentifiée, faute
    // de Cloud Function planifiée pour détecter les transitions basées sur la date) et il
    // n'introduit aucun risque : rendre une police PLUS restrictive n'est jamais une
    // élévation de privilège.
    match /healthPolicies/{organizationName} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() && isActiveUser() && (
        isAdmin() || isSupervisor() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'coverageBlocked', 'updatedAt', 'lastEvaluatedAt']) &&
          !(resource.data.coverageBlocked == true && request.resource.data.coverageBlocked != true)
        )
      );
    }

    // policyPayments collection (financial transactions restricted to Admin)
    // === AMÉLIORATION AJOUTÉE : sécurité (Phase 1.3) — lecture désormais cloisonnée par
    // organisation via hasOrgAccess() (voir définition plus haut) ; écriture inchangée
    // (déjà réservée à isAdmin(), qui passe toujours hasOrgAccess()).
    match /policyPayments/{paymentId} {
      allow read: if isSignedIn() && hasOrgAccess(resource.data.organizationId);
      allow write: if isAdmin();
    }

    // claims collection (with SoD validation enforcement)
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif LOW) — `isAdmin() ||` en tête de la
    // condition court-circuitait le test d'auto-approbation pour un Admin : un Admin qui aurait
    // créé sa propre réclamation (autorisé par la matrice de permissions) pouvait se
    // l'approuver lui-même, contrairement à ce que documente AUDIT_AND_HARDENING_REPORT.md
    // ("Admin... sauf s'il en est lui-même l'auteur direct") et à ce qu'applique la Cloud
    // Function processClaimDecisionServer (qui bloque l'auto-approbation pour TOUT rôle).
    // Corrigé pour que Admin soit soumis au même test d'auto-approbation que Supervisor.
    // === AMÉLIORATION AJOUTÉE : sécurité (Phase 1.3) — read/create/update cloisonnés par
    // organisation via hasOrgAccess() ; empêche aussi de "déplacer" un claim vers une
    // organisation hors périmètre lors d'une mise à jour.
    match /claims/{claimId} {
      allow read: if isSignedIn() && hasOrgAccess(resource.data.organization);
      allow create: if isSignedIn() && isActiveUser() && !policyBlocksCoverage(request.resource.data.organization) &&
        hasOrgAccess(request.resource.data.organization) && createdByUidValid();
      allow update: if isSignedIn() && isActiveUser() &&
        hasOrgAccess(resource.data.organization) &&
        (!('organization' in request.resource.data) || hasOrgAccess(request.resource.data.organization)) && (
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) ||
        ((isAdmin() || isSupervisor()) && !isSelfCreated(resource.data))
      );
      allow delete: if isAdmin();
    }

    // medicalForms collection
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif MEDIUM) — la suppression était ouverte à
    // tout utilisateur actif, sans notion de propriétaire (le type MedicalForm ne porte aucun
    // champ createdBy) : n'importe quel Agent pouvait donc supprimer la fiche médicale de
    // n'importe quel autre Agent, y compris via le nouveau bouton "Clear All History" qui
    // supprime TOUTE la collection en un seul lot, quel que soit l'auteur ou l'organisation.
    // Restreint à isAdmin(), cohérent avec claims/enrollments ci-dessus et avec la matrice de
    // permissions (permissions.ts : suppression réservée à Admin, jamais Agent/Supervisor).
    // === AMÉLIORATION AJOUTÉE : sécurité (Phase 1.3) — read/create/update cloisonnés par
    // organisation via hasOrgAccess().
    match /medicalForms/{formId} {
      allow read: if isSignedIn() && hasOrgAccess(resource.data.organization);
      allow create: if isSignedIn() && isActiveUser() && !policyBlocksCoverage(request.resource.data.organization) &&
        hasOrgAccess(request.resource.data.organization) && createdByUidValid();
      allow update: if isSignedIn() && isActiveUser() &&
        hasOrgAccess(resource.data.organization) &&
        (!('organization' in request.resource.data) || hasOrgAccess(request.resource.data.organization));
      allow delete: if isAdmin();
    }

    // enrollments collection (with SoD validation enforcement)
    // === AMÉLIORATION AJOUTÉE : sécurité (correctif LOW) — même correctif que /claims
    // ci-dessus : Admin soumis au même test d'auto-approbation que Supervisor.
    // === AMÉLIORATION AJOUTÉE : sécurité (Phase 1.3) — read/create/update cloisonnés par
    // organisation via hasOrgAccess().
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && hasOrgAccess(resource.data.organization);
      allow create: if isSignedIn() && isActiveUser() && hasOrgAccess(request.resource.data.organization) && createdByUidValid();
      allow update: if isSignedIn() && isActiveUser() &&
        hasOrgAccess(resource.data.organization) &&
        (!('organization' in request.resource.data) || hasOrgAccess(request.resource.data.organization)) && (
        (!('status' in request.resource.data) || request.resource.data.status == resource.data.status) ||
        ((isAdmin() || isSupervisor()) && !isSelfCreated(resource.data))
      );
      allow delete: if isAdmin();
    }

    // invoices collection (issued receipts upon claim approval)
    // === AMÉLIORATION AJOUTÉE : sécurité (Phase 1.3) — read/create/update cloisonnés par
    // organisation via hasOrgAccess(). Séparé en deux règles (create/update) car `resource`
    // n'existe pas encore lors d'une création.
    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && hasOrgAccess(resource.data.organization);
      allow create: if isSignedIn() && isActiveUser() && canValidate() && hasOrgAccess(request.resource.data.organization);
      allow update: if isSignedIn() && isActiveUser() && canValidate() &&
        hasOrgAccess(resource.data.organization) &&
        (!('organization' in request.resource.data) || hasOrgAccess(request.resource.data.organization));
      allow delete: if isAdmin();
    }

    // organizations, providers, ceilings (administrative masters)
    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /providers/{providerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /ceilings/{ceilingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // loginLogs & auditLogs (append-only, immutable)
    match /loginLogs/{logId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (isAdmin() || isSupervisor());
      allow create: if true;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
  }
}
